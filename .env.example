# mikeos-storyteller-cloud configuration

# REQUIRED at runtime. Railway auto-provides this when you attach a Postgres
# plugin. Locally, point it at any Postgres instance.
DATABASE_URL=postgresql://user:password@localhost:5432/mikeos_storyteller

# REQUIRED for GPU story generation. The FREE shared GPU (Ollama), as
# ollama://user:pass@host:port . Without it the service falls back to a
# deterministic template (never a paid API). Grab the value from an existing
# service: railway variables -s mikeos-photos-cloud -e production | grep OLLAMA_GPU_URL
# OLLAMA_GPU_URL=ollama://user:pass@host:port

# OPTIONAL. Text model for story generation (default: qwen3:8b).
# OLLAMA_TEXT_MODEL=qwen3:8b

# OPTIONAL. Identity provider used to resolve an app's hive agent key
# (X-API-KEY header) to a user_id. Defaults to production.
# MIKEOSCOMPUTERS_URL=https://mikeoscomputers-production.up.railway.app

# OPTIONAL. Schema data is stored under (default: storyteller).
# STORYTELLER_SCHEMA=storyteller

# OPTIONAL. Log level (default: INFO).
# LOG_LEVEL=INFO
